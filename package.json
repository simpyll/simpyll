{
  "name": "simpyll",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "npm run validate:projects && npm run generate:redirects && npm run generate:images && npm run generate:search && vite",
    "generate:sitemap": "node scripts/generate-sitemap.mjs",
    "build:client": "npm run validate:projects && tsc -b && vite build",
    "build:server": "npm run validate:projects && vite build --ssr src/entry-server.tsx --outDir dist-server",
    "prerender": "node scripts/prerender.mjs",
    "build": "npm run validate:projects && npm run generate:redirects && npm run validate:content && npm run generate:images && npm run generate:search && npm run generate:sitemap && npm run build:client && npm run build:server && npm run prerender && node scripts/smoke/generate.mjs",
    "lint": "eslint .",
    "preview": "vite preview",
    "sync:notion": "node scripts/sync-notion.mjs",
    "test:notion": "node --test scripts/notion/*.test.mjs",
    "test:notion:build": "node --test scripts/notion-build.test.mjs",
    "validate:content": "node scripts/validate-content.mjs",
    "test:mdx": "node --test scripts/mdx.test.mjs scripts/rich-content.test.mjs",
    "test:content": "node --test scripts/validate-content.test.mjs",
    "test": "npm run build && npm run test:images && node --test scripts/*.test.mjs scripts/notion/*.test.mjs && npm run test:smoke && npm run test:e2e:built",
    "test:e2e": "npm run build && npm run test:e2e:built",
    "test:e2e:built": "playwright test",
    "test:e2e:report": "playwright show-report",
    "generate:search": "node scripts/generate-search.mjs",
    "test:search": "node --test scripts/search.test.mjs",
    "smoke:http": "node scripts/smoke/run.mjs",
    "smoke:browser": "playwright test --config playwright.production.config.ts",
    "test:smoke": "node --test scripts/smoke/*.test.mjs",
    "generate:images": "node scripts/images/build.mjs",
    "test:images": "node --test scripts/images/*.test.mjs",
    "test:a11y": "playwright test accessibility",
    "generate:redirects": "node scripts/generate-redirects.mjs",
    "test:redirects": "node --test scripts/redirects.test.mjs",
    "validate:projects": "node scripts/generate-projects.mjs",
    "test:projects": "node --test scripts/projects.test.mjs scripts/projects-build.test.mjs scripts/project-lab.test.mjs"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@mdx-js/react": "^3.1.1",
    "@tailwindcss/vite": "^4.3.3",
    "motion": "^14.3.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-helmet-async": "^3.0.0",
    "react-router-dom": "^6.30.6",
    "tailwindcss": "^4.3.3"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@eslint/js": "^10.0.1",
    "@mdx-js/mdx": "^3.1.1",
    "@mdx-js/rollup": "^3.1.1",
    "@playwright/test": "^1.64.1",
    "@tailwindcss/typography": "^0.5.20",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "eslint": "^10.10.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.6",
    "fast-xml-parser": "^5.11.2",
    "globals": "^17.12.0",
    "linkedom": "^0.18.14",
    "rehype-highlight": "^7.0.2",
    "remark-gfm": "^4.0.1",
    "remark-mdx": "^3.1.1",
    "remark-parse": "^11.0.0",
    "sharp": "^0.35.5",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.69.0",
    "unified": "^11.0.5",
    "vite": "^8.3.0"
  }
}
