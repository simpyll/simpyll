{
  "name": "simpyll",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "generate:sitemap": "node scripts/generate-sitemap.mjs",
    "build:client": "tsc -b && vite build",
    "build:server": "vite build --ssr src/entry-server.tsx --outDir dist-server",
    "prerender": "node scripts/prerender.mjs",
    "build": "npm run validate:content && npm run generate:sitemap && npm run build:client && npm run build:server && npm run prerender",
    "lint": "eslint .",
    "preview": "vite preview",
    "sync:notion": "node scripts/sync-notion.mjs",
    "test:notion": "node --test scripts/notion/*.test.mjs",
    "test:notion:build": "node --test scripts/notion-build.test.mjs",
    "validate:content": "node scripts/validate-content.mjs",
    "test:content": "node --test scripts/validate-content.test.mjs",
    "test": "npm run build && node --test scripts/*.test.mjs scripts/notion/*.test.mjs && npm run test:e2e:built",
    "test:e2e": "npm run build && npm run test:e2e:built",
    "test:e2e:built": "playwright test",
    "test:e2e:report": "playwright show-report"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@mdx-js/react": "^3.1.1",
    "@tailwindcss/vite": "^4.3.3",
    "motion": "^14.3.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-helmet-async": "^3.0.0",
    "react-router-dom": "^6.30.6",
    "tailwindcss": "^4.3.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@mdx-js/mdx": "^3.1.1",
    "@mdx-js/rollup": "^3.1.1",
    "@playwright/test": "^1.64.1",
    "@tailwindcss/typography": "^0.5.20",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "eslint": "^10.10.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.6",
    "globals": "^17.12.0",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.69.0",
    "vite": "^8.3.0"
  }
}
